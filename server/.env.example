# Copy to .env on the server. Never commit .env.
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
# llm or template. template never sends customer text to an AI model.
DRAFTS=llm
CLAUDE_MODEL=claude-sonnet-5-5
SHOP_NAME=TechnoTochka demo shop
DATA_DIR=./data
CATALOG_PATH=./catalog/catalog.json
# Comma-separated origins allowed to call the API (the glasses app).
ALLOWED_ORIGINS=http://localhost:5173
WHISPER_MODEL=small
